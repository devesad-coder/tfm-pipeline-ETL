    <dashboard enable-sort-zone-taborder='true' name='DEFENSA Y REGATES'>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#fefaf1' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='range' />
      <datasources>
        <datasource caption='Parámetros' name='Parameters' />
        <datasource caption='Kpis Jugadores' name='federated.0p8b8eb1hv6r9v1h5qf5v0au9jo2' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Regates Exitosos' caption='Ranking (regates) ' datatype='string' name='[Ranking (tiros) (copia)_2127874917273600]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regates exitosos&quot;'>
          <calculation class='tableau' formula='&quot;Regates exitosos&quot;' />
          <aliases>
            <alias key='&quot;Regates exitosos&quot;' value='Regates Exitosos' />
          </aliases>
          <members>
            <member value='&quot;Eficiencia Regates&quot;' />
            <member alias='Regates Exitosos' value='&quot;Regates exitosos&quot;' />
          </members>
        </column>
        <column caption='Ranking (Entradas) ' datatype='string' name='[Ranking (tiros) (copia)_2127874933239811]' param-domain-type='list' role='measure' type='nominal' value='&quot;Eficiencia Entradas \%&quot;'>
          <calculation class='tableau' formula='&quot;Eficiencia Entradas %&quot;' />
          <members>
            <member value='&quot;Eficiencia Entradas \%&quot;' />
            <member value='&quot;Entradas Exitosas&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0p8b8eb1hv6r9v1h5qf5v0au9jo2'>
        <column caption='Posición Agrupación' datatype='string' name='[Calculation_0122365454708736]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([POSICION_PRINCIPAL], &quot;Goalkeeper&quot;) THEN &quot;Portero&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL], &quot;Back&quot;) THEN &quot;Defensa&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL], &quot;Forward&quot;) OR CONTAINS([POSICION_PRINCIPAL], &quot;Wing&quot;) THEN &quot;Delantero&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL], &quot;Midfield&quot;) THEN &quot;Centrocampista&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
        </column>
        <column caption='Minutos Jugados' datatype='integer' name='[MINUTOS_JUGADOS]' role='measure' type='quantitative' />
        <column caption='Nombre Equipo' datatype='string' name='[NOMBRE_EQUIPO]' role='dimension' type='nominal' />
        <column caption='Nombre Jugador' datatype='string' name='[NOMBRE_JUGADOR]' role='dimension' type='nominal' />
        <column caption='Regates Intentados' datatype='integer' name='[REGATES_INTENTADOS]' role='measure' type='quantitative' />
        <column-instance column='[Calculation_0122365454708736]' derivation='None' name='[none:Calculation_0122365454708736:nk]' pivot='key' type='nominal' />
        <column-instance column='[MINUTOS_JUGADOS]' derivation='None' name='[none:MINUTOS_JUGADOS:qk]' pivot='key' type='quantitative' />
        <column-instance column='[NOMBRE_EQUIPO]' derivation='None' name='[none:NOMBRE_EQUIPO:nk]' pivot='key' type='nominal' />
        <column-instance column='[NOMBRE_JUGADOR]' derivation='None' name='[none:NOMBRE_JUGADOR:nk]' pivot='key' type='nominal' />
        <column-instance column='[REGATES_INTENTADOS]' derivation='None' name='[none:REGATES_INTENTADOS:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='26555' id='18' param='horz' type-v2='layout-flow' w='98934' x='533' y='889'>
            <zone h='26555' id='26' is-fixed='true' type-v2='layout-basic' w='98934' x='533' y='889'>
              <zone h='21201' id='30' is-fixed='true' type-v2='layout-basic' w='98934' x='533' y='6243'>
                <zone fixed-size='133' h='11468' id='25' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='6243'>
                  <zone forceUpdate='true' h='11468' id='29' type-v2='text' w='98934' x='533' y='6243'>
                    <formatted-text>
                      <run>Este dashboard evalúa la solidez defensiva y la capacidad de desborde individual de la plantilla. El diagrama de dispersión identifica perfiles defensivos destacados mediante Machine Learning (Isolation Forest), analizando recuperaciones y eficiencia de pase. Por su parte, los rankings muestran el volumen de regates y entradas completadas, permitiendo localizar a las jugadoras más efectivas en la recuperación y el uno contra uno.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
