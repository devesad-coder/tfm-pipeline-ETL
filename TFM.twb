    <worksheet name='Red de pases'>
      <table>
        <view>
          <datasources>
            <datasource caption='Redes de pases' name='federated.16qw26b0zy22id1cfieai0josu7k' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Mínimo de Minutos' datatype='integer' name='[Parámetro 2]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <range max='2124' min='0' />
            </column>
            <column caption='Mínimo Partidos de Titular' datatype='integer' name='[Parámetro 3]' param-domain-type='range' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <range max='22' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16qw26b0zy22id1cfieai0josu7k'>
            <column caption='Posición Agrupación' datatype='string' name='[Calculation_0122365524029446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([POSICION_PRINCIPAL], &quot;Goalkeeper&quot;) THEN &quot;Portero&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL], &quot;Back&quot;) THEN &quot;Defensa&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL], &quot;Forward&quot;) OR CONTAINS([POSICION_PRINCIPAL], &quot;Wing&quot;) THEN &quot;Delantero&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL], &quot;Midfield&quot;) THEN &quot;Centrocampista&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
            </column>
            <column caption='Posición Agrupación2' datatype='string' name='[Calculation_0122365532295179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([POSICION_PRINCIPAL (Kpis Jugadores.csv1)], &quot;Goalkeeper&quot;) THEN &quot;Portero&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL (Kpis Jugadores.csv1)], &quot;Back&quot;) THEN &quot;Defensa&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL (Kpis Jugadores.csv1)], &quot;Forward&quot;) OR CONTAINS([POSICION_PRINCIPAL (Kpis Jugadores.csv1)], &quot;Wing&quot;) THEN &quot;Delantero&quot;&#13;&#10;ELSEIF CONTAINS([POSICION_PRINCIPAL (Kpis Jugadores.csv1)], &quot;Midfield&quot;) THEN &quot;Centrocampista&quot;&#13;&#10;ELSE &quot;Otros&quot;&#13;&#10;END' />
            </column>
            <column caption='Filtro minutos global' datatype='boolean' name='[Calculation_0122365534990348]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[MINUTOS_JUGADOS] &gt;= [Parameters].[Parámetro 2] AND [MINUTOS_JUGADOS (Kpis Jugadores.csv1)] &gt;= [Parameters].[Parámetro 2]' />
            </column>
            <column caption='Partidos Titular Global' datatype='boolean' name='[Calculation_0122365540466701]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[PARTIDOS_TITULAR] &gt;= [Parameters].[Parámetro 3] AND [PARTIDOS_TITULAR (Kpis Jugadores.csv1)] &gt;= [Parameters].[Parámetro 3]' />
            </column>
            <column caption='MINUTOS JUGADOS (Kpis Jugadores.csv1)' datatype='integer' name='[MINUTOS_JUGADOS (Kpis Jugadores.csv1)]' role='measure' type='quantitative' />
            <column caption='Minutos Jugados' datatype='integer' name='[MINUTOS_JUGADOS]' role='measure' type='quantitative' />
