                <zone forceUpdate='true' h='6777' id='28' type-v2='text' w='98934' x='533' y='889'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontsize='16'>ANÁLISIS DE CONECTIVIDAD Y DINÁMICA COLECTIVA (REDES DE PASES)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
